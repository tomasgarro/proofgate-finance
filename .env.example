# ProofGate Finance — environment variables
# Copy this file to .env and fill in your keys
# NEVER commit the .env file to git (it is in .gitignore)

# ── Required ──────────────────────────────────────────────────────────────────

# SEC EDGAR identity (free, no sign-up needed)
# The SEC requires this in every request header
# Format: "Your Full Name your@email.com"
SEC_IDENTITY="Your Name your@email.com"

# ── Research agent (AI diff layer) ────────────────────────────────────────────

# Anthropic API key — used for the --diff flag (Risk Factors + MD&A comparison)
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Financial data ────────────────────────────────────────────────────────────

# FinancialModelingPrep — structured financials for FinanceToolkit
# Free tier: 250 requests/day, 5 years of data, US companies only
# Get it at: https://financialmodelingprep.com/developer/docs (click "Get your API key")
FMP_API_KEY=""

# ── On-chain / DeFi ───────────────────────────────────────────────────────────

# Dune Analytics — blockchain SQL analytics
# Free account gives you API access with limited credits per month
# Get it at: https://dune.com/auth/register → Settings → API
DUNE_API_KEY=""

# Xerberus Risk API — risk scores for Cardano, Ethereum, Polygon tokens
# Covers assets, protocols, organizations, vaults, and DeFi pools
# Get it at: contact ms@xerberus.io or request at https://app.xerberus.io
# Authentication needs both key AND email
XERBERUS_API_KEY=""
XERBERUS_EMAIL=""

# ── Optional / future ─────────────────────────────────────────────────────────

# Nansen — smart money wallet labels ($49/mo)
# https://pro.nansen.ai/api-documentation
# NANSEN_API_KEY=""

# Messari — research and token data (free tier available)
# https://messari.io/api
# MESSARI_API_KEY=""
